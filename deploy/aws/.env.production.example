# ==============================================================================
# AWS Production Environment Configuration
# ==============================================================================

# API Keys (Required for Synthesis & Roadmaps)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# LLM Models Configuration
DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_SYNTHESIS_MODEL=gemini-3.5-flash-lite

# Pipeline & Reranker Settings
PROMPT_PIPELINE_ENABLED=false
PIPELINE_RERANK_SCORE_FLOOR=4.0
PIPELINE_MAX_RETRIES=2

# Multi-Format Ingestion
MULTIFORMAT_ENABLED=true
MULTIFORMAT_FORMATS=docx,pptx,doc,ppt,xlsx
CANONICAL_RENDERER=libreoffice

# Domain Configuration for Caddy (Auto-SSL via Let's Encrypt)
# Set to your domain (e.g., api.yourdomain.com) or leave as :80 if using raw IP
DOMAIN_NAME=:80
